{
  "name": "wheelmates-wiki",
  "compatibility_date": "2026-09-07",
  "routes": [
    { "pattern": "wheelmates-wiki.wiki/*", "zone_name": "wheelmates-wiki.wiki" }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
